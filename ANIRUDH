Aim: - To implement a Java-based Log Processor Simulator using the MapReduce programming model to analyze server log data, calculate the total active time of each user, and identify the user with the maximum active time.

Description:- The program simulates the three phases of MapReduce: Map, Shuffle and Sort, and Reduce. In the Map phase, server log records are processed to extract usernames, login/logout actions, and timestamps. In the Shuffle and Sort phase, intermediate key-value pairs are grouped by username. In the Reduce phase, the timestamp values are aggregated to calculate each user's total active time, and the user with the maximum active time is identified.
The program uses Java collections and Streams to simulate Hadoop's MapReduce workflow without requiring an actual Hadoop cluster.

import java.util.*;
import java.util.stream.Collectors;

public class LogProcessorSimulator {

    public static void main(String[] args) {

        String[] logs = {
            "alice LOGIN 1000",
            "alice LOGOUT 1600",
            "bob LOGIN 2000",
            "bob LOGOUT 3500",
            "charlie LOGIN 3000",
            "charlie LOGOUT 7000"
        };

        // 1. MAP PHASE
        Map<String, List<Long>> map = new HashMap<>();

        for (String log : logs) {
            String[] data = log.split(" ");
            String user = data[0];
            String action = data[1];
            long time = Long.parseLong(data[2]);

            long value = action.equals("LOGIN") ? -time : time;

            map.computeIfAbsent(user, k -> new ArrayList<>())
               .add(value);
        }

        System.out.println("1. MAP PHASE");
        map.forEach((user, values) ->
            System.out.println(user + " -> " + values));

        // 2. SHUFFLE AND SORT PHASE
        Map<String, List<Long>> grouped = map.entrySet()
            .stream()
            .collect(Collectors.toMap(
                Map.Entry::getKey,
                Map.Entry::getValue,
                (a, b) -> a,
                TreeMap::new
            ));

        System.out.println("\n2. SHUFFLE AND SORT PHASE");
        grouped.forEach((user, values) ->
            System.out.println(user + " -> " + values));

        // 3. REDUCE PHASE
        System.out.println("\n3. REDUCE PHASE");

        String topUser = "";
        long max = -1;

        for (String user : grouped.keySet()) {
            long total = grouped.get(user).stream()
                                .mapToLong(Long::longValue)
                                .sum();

            System.out.println(user + " = " + total + " seconds");

            if (total > max) {
                max = total;
                topUser = user;
            }
        }

        System.out.println("\nMaximum active user: " + topUser);
        System.out.println("Total active time: " + max + " seconds");
    }
}
