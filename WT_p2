<!DOCTYPE html> 
<html> 
<head> 
    <title>User Details</title> 
</head> 
<body> 
    <h1>Find User Details</h1> 
    <label for="userIdInput">Enter User ID:</label> 
    <input type="number" id="userIdInput"> 
    <button onclick="getUserDetails()">Get Details</button> 
    <div id="userDetails"></div> 
 
    <script> 
        function getUserDetails() { 
            const userId = document.getElementById('userIdInput').value; 
            const userDetailsDiv = document.getElementById('userDetails'); 
            userDetailsDiv.innerHTML = ' '; // Clear previous results 
            if (!userId) { 
                userDetailsDiv.innerHTML = '<p>Please enter a User ID.</p>'; 
                return; 
            } 
 
            const xhr = new XMLHttpRequest(); 
            xhr.open('GET', 'users.xml', true); // Assuming users.xml is in the same directory 
            xhr.onload = function () { 
                if (xhr.status === 200) { 
                    const xmlDoc = xhr.responseXML; 
                    if (xmlDoc) { 
                        const users = xmlDoc.getElementsByTagName('user'); 
                        let foundUser = false; 
                        for (let i = 0; i < users.length; i++) { 
                            const idElement = users[i].getElementsByTagName('id')[0]; 
                            if (idElement && idElement.textContent === userId) { 
                                const name = users[i].getElementsByTagName('name')[0].textContent; 
                                const email = users[i].getElementsByTagName('email')[0].textContent; 
                                const city = users[i].getElementsByTagName('city')[0].textContent; 
 
                                userDetailsDiv.innerHTML =  
                                    <p><strong>User ID:</strong> ${userId}</p> 
                                    <p><strong>Name:</strong> ${name}</p> 
                                    <p><strong>Email:</strong> ${email}</p> 
                                    <p><strong>City:</strong> ${city}</p> 
                                ; 
                                foundUser = true; 
                                break; 
                            } 
                        } 
                        if (!foundUser) { 
                            userDetailsDiv.innerHTML = '<p>User not found.</p>'; 
                        } 
                    } else { 
                        userDetailsDiv.innerHTML = '<p>Error parsing XML document.</p>'; 
                    } 
                } else { 
                    userDetailsDiv.innerHTML = `<p>Error loading XML: ${xhr.status}</p>`; 
                } 
            }; 
            xhr.onerror = function () { 
                userDetailsDiv.innerHTML = '<p>Network error occurred while loading 
XML.</p>'; 
            }; 
            xhr.send();  
        } 
    </script> 
</body> 
</html> 
